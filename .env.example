# Токен бота, который будет присылать заявки: получите у @BotFather.
# Эти две строки читает npm run deploy:yandex. В Cloudflare их задают в панели, не из файла.
TELEGRAM_BOT_TOKEN=

# Ваш chat_id: напишите боту @userinfobot, он покажет число
TELEGRAM_CHAT_ID=

# Пароль страницы /admin. Если пусто, deploy:yandex запишет новый в .env.
ADMIN_PASSWORD=
