# Запасные токен и chat_id, если в админке они ещё не сохранены.
# Дальше их правят на /admin. На сайт эти значения не попадают.
# Письмо о заявке тоже настраивается там: адрес, smtp и пароль приложения.
TELEGRAM_BOT_TOKEN=

# Ваш chat_id: напишите боту @userinfobot, он покажет число
TELEGRAM_CHAT_ID=

# Пароль страницы /admin. Если пусто, deploy:yandex запишет новый в .env.
ADMIN_PASSWORD=
