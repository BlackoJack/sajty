# Запасные токен и chat_id, если в админке они ещё не сохранены.
# Дальше их правят на /admin. На сайт эти значения не попадают.
# Письмо о заявке тоже настраивается там: адрес, smtp и пароль приложения.
TELEGRAM_BOT_TOKEN=

# Ваш chat_id: напишите боту @userinfobot, он покажет число
TELEGRAM_CHAT_ID=

# Пароль страницы /admin. Если пусто, deploy:yandex запишет новый в .env.
ADMIN_PASSWORD=

# SEO (попадают в сборку через PUBLIC_* — только ID/коды верификации, не секреты).
# Счётчик: https://metrika.yandex.ru/ → номер счётчика
PUBLIC_YANDEX_METRIKA_ID=
# Вебмастер: https://webmaster.yandex.ru/ → мета-тег verification
PUBLIC_YANDEX_VERIFICATION=
# Google Search Console → HTML-тег
PUBLIC_GOOGLE_SITE_VERIFICATION=
# IndexNow: значение из public/sitly-indexnow.txt (публичный ключ, не секрет).
PUBLIC_INDEXNOW_KEY=
