<script>
  const money = (value: number) => Number(value).toLocaleString("ru-RU").replace(/\u00A0/g, " ");

  function escapeHtml(value: string) {
    return value.replace(/[&<>"']/g, (char) => {
      const map: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" };
      return map[char];
    });
  }

  const contactRules: Record<string, { protocol: string; hosts?: string[] }> = {
    telegram: { protocol: "https:", hosts: ["t.me", "telegram.me"] },
    whatsapp: { protocol: "https:", hosts: ["wa.me", "api.whatsapp.com"] },
    max: { protocol: "https:", hosts: ["max.ru"] },
    email: { protocol: "mailto:" },
  };

  function contactHref(id: string, value: string) {
    try {
      const url = new URL(value);
      const rule = contactRules[id];
      if (!rule || url.protocol !== rule.protocol) return "";
      if (rule.hosts && !rule.hosts.includes(url.hostname.toLowerCase())) return "";
      return url.toString();
    } catch {
      return "";
    }
  }

  function applyContacts(contacts?: Record<string, { label?: string; url?: string }>) {
    if (!contacts) return;
    for (const id of Object.keys(contactRules)) {
      const item = contacts[id];
      if (!item) continue;
      const href = item.url ? contactHref(id, item.url) : "";
      document.querySelectorAll<HTMLAnchorElement>(`[data-contact="${id}"]`).forEach((node) => {
        node.hidden = !href;
        if (!href) return;
        node.href = href;
        const label = node.querySelector("[data-contact-label]");
        if (label && item.label) label.textContent = item.label;
      });
    }
    document.querySelectorAll<HTMLElement>("[data-contact-group]").forEach((group) => {
      const links = [...group.querySelectorAll<HTMLAnchorElement>("[data-contact]")];
      const visible = links.filter((node) => !node.hidden);
      group.hidden = visible.length === 0;
      const joiner = group.querySelector<HTMLElement>("[data-contact-and]");
      if (joiner) joiner.hidden = visible.length < 2;
    });
  }

  function applyProfile(profile?: { name?: string }) {
    const name = String(profile?.name || "").replace(/\s+/g, " ").trim();
    document.querySelectorAll<HTMLElement>("[data-profile-name]").forEach((node) => {
      node.textContent = name;
      node.hidden = !name;
    });
    return name;
  }

  function applyExample(example?: { url?: string }) {
    let href = "";
    try {
      const url = new URL(String(example?.url || ""));
      if (url.protocol === "https:" && !url.username && !url.password) href = url.toString();
    } catch {
      href = "";
    }
    document.querySelectorAll<HTMLAnchorElement>("[data-example]").forEach((node) => {
      const cta = node.hasAttribute("data-example-cta");
      if (!href) {
        node.removeAttribute("href");
        if (cta) node.hidden = true;
        return;
      }
      node.href = href;
      node.target = "_blank";
      node.rel = "noopener";
      node.hidden = false;
    });
  }

  function apply(content: {
    price?: Record<string, number>;
    packages?: { id: string; name: string; tagline: string; bestFor: string; items: string[] }[];
    contacts?: Record<string, { label?: string; url?: string }>;
    profile?: { name?: string };
    example?: { url?: string };
    popups?: Popup[];
  }) {
    const profileName = applyProfile(content.profile);
    applyExample(content.example);
    applyContacts(content.contacts);
    const price = content.price ?? {};
    const visitka = document.querySelector("[data-price-slot='visitka']");
    if (visitka && Number.isFinite(price.visitka)) visitka.textContent = `от ${money(price.visitka)} ₽`;

    for (const pkg of content.packages ?? []) {
      const priceValue = price[pkg.id];
      const card = document.querySelector(`[data-package="${pkg.id}"]`);
      if (card) {
        const priceNode = card.querySelector("[data-package-price]");
        const nameNode = card.querySelector("[data-package-name]");
        const taglineNode = card.querySelector("[data-package-tagline]");
        const bestNode = card.querySelector("[data-package-best]");
        const itemsNode = card.querySelector("[data-package-items]");
        if (priceNode && Number.isFinite(priceValue)) priceNode.textContent = `от ${money(priceValue)} ₽`;
        if (nameNode && pkg.name) nameNode.textContent = pkg.name;
        if (taglineNode && pkg.tagline) taglineNode.textContent = pkg.tagline;
        if (bestNode && pkg.bestFor) bestNode.textContent = pkg.bestFor;
        if (itemsNode && Array.isArray(pkg.items)) {
          itemsNode.innerHTML = pkg.items
            .map(
              (item) =>
                `<li class="relative pl-6 text-[14px] leading-snug text-ink/85"><span class="absolute left-0 top-0 font-mono text-[13px] text-ink/30" aria-hidden="true">+</span>${escapeHtml(item)}</li>`,
            )
            .join("");
        }
      }

      const typeButton = document.querySelector<HTMLButtonElement>(`[data-type][data-id="${pkg.id}"]`);
      if (typeButton) {
        if (Number.isFinite(priceValue)) typeButton.dataset.price = String(priceValue);
        if (pkg.name) typeButton.dataset.label = pkg.name;
        const spans = typeButton.querySelectorAll("span");
        if (spans[0] && pkg.name) spans[0].textContent = pkg.name;
        if (spans[1] && Number.isFinite(priceValue)) spans[1].textContent = `от ${money(priceValue)} ₽`;
      }
    }

    for (const id of ["texts", "setup", "support"]) {
      const button = document.querySelector<HTMLButtonElement>(`[data-extra][data-id="${id}"]`);
      const value = price[id];
      if (!button || !Number.isFinite(value)) continue;
      button.dataset.price = String(value);
      const cost = button.querySelector(".ml-auto");
      if (cost) cost.textContent = `+ ${money(value)} ₽${button.dataset.monthly === "1" ? "/мес" : ""}`;
    }

    const ld = document.querySelector('script[type="application/ld+json"]');
    if (ld?.textContent && (profileName || Number.isFinite(price.visitka))) {
      try {
        const data = JSON.parse(ld.textContent);
        if (data.offers && Number.isFinite(price.visitka)) data.offers.price = price.visitka;
        if (profileName) {
          data.provider = { "@type": "Person", name: profileName };
          data.name = `Sitly.ru — ${profileName}`;
        }
        ld.textContent = JSON.stringify(data);
      } catch {
        /* запасная разметка остаётся */
      }
    }

    document.documentElement.dataset.contentReady = "1";
    document.dispatchEvent(new Event("site-content"));
    queuePopup(content);
  }

  type Popup = {
    id: string;
    title?: string;
    text?: string;
    kind?: string;
    mode?: string;
    value?: number;
    gift?: string;
    code?: string;
    delay?: number;
    repeat?: string;
  };

  function popupSeen(popup: Popup) {
    const store = popup.repeat === "visit" ? sessionStorage : localStorage;
    try {
      const data = JSON.parse(store.getItem("sajty-popups") || "{}");
      return data?.[popup.id] === "take" || data?.[popup.id] === "close";
    } catch {
      return false;
    }
  }

  function rememberPopup(popup: Popup, state: string) {
    const store = popup.repeat === "visit" ? sessionStorage : localStorage;
    let data: Record<string, string> = {};
    try {
      const parsed = JSON.parse(store.getItem("sajty-popups") || "{}");
      if (parsed && typeof parsed === "object") data = parsed;
    } catch {
      data = {};
    }
    data[popup.id] = state;
    store.setItem("sajty-popups", JSON.stringify(data));
  }

  function perkLine(popup: Popup) {
    if (popup.kind === "discount") {
      const size = popup.mode === "amount" ? `${money(Number(popup.value) || 0)} ₽` : `${popup.value || 0}%`;
      return `Скидка ${size}. Она приложится к заявке.`;
    }
    if (popup.kind === "gift" && popup.gift) return `Подарок: ${popup.gift}. Напишем его в заявке.`;
    return "";
  }

  function takeLabel(popup: Popup) {
    if (popup.kind === "discount") return "Забрать скидку";
    if (popup.kind === "gift") return "Забрать подарок";
    return "Хорошо";
  }

  function showOfferNote(popup: Popup) {
    const note = document.getElementById("offer-note");
    if (!note || !popup.code) return;
    note.hidden = false;
    note.textContent = perkLine(popup) || "Приложим к заявке.";
  }

  let popupTimer = 0;

  function openNotice(popup: Popup) {
    if (document.querySelector(".popup-layer")) return;
    const layer = document.createElement("div");
    layer.className = "popup-layer";
    const card = document.createElement("div");
    card.className = "popup-card";
    card.setAttribute("role", "dialog");
    card.setAttribute("aria-modal", "true");
    card.setAttribute("aria-labelledby", "popup-title");
    const closeButton = document.createElement("button");
    closeButton.className = "popup-close";
    closeButton.type = "button";
    closeButton.setAttribute("aria-label", "Закрыть");
    closeButton.textContent = "×";
    const kicker = document.createElement("p");
    kicker.className = "popup-kicker";
    kicker.textContent = "Sitly.ru";
    const title = document.createElement("h2");
    title.id = "popup-title";
    title.className = "popup-title";
    title.textContent = popup.title || "";
    const text = document.createElement("p");
    text.className = "popup-text";
    text.textContent = popup.text || "";
    card.append(closeButton, kicker, title, text);
    const perk = perkLine(popup);
    if (perk) {
      const perkNode = document.createElement("p");
      perkNode.className = "popup-perk";
      perkNode.textContent = perk;
      card.append(perkNode);
    }
    const take = document.createElement("button");
    take.className = "btn btn-lime popup-take";
    take.type = "button";
    take.textContent = takeLabel(popup);
    card.append(take);
    layer.append(card);
    const close = (state: string) => {
      if (state === "take" && popup.code && popup.kind !== "message") {
        sessionStorage.setItem("sajty-offer", popup.code);
        showOfferNote(popup);
        document.getElementById("contact")?.scrollIntoView({ behavior: "smooth", block: "start" });
      }
      rememberPopup(popup, state);
      layer.remove();
      document.removeEventListener("keydown", onKey);
    };
    const onKey = (event: KeyboardEvent) => {
      if (event.key === "Escape") close("close");
    };
    layer.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest(".popup-take")) close("take");
      else if (target === layer || target.closest(".popup-close")) close("close");
    });
    document.addEventListener("keydown", onKey);
    document.body.append(layer);
    take.focus();
  }

  function queuePopup(content: { popups?: Popup[] }) {
    window.clearTimeout(popupTimer);
    const popups = Array.isArray(content.popups) ? content.popups : [];
    const kept = sessionStorage.getItem("sajty-offer") || "";
    const held = popups.find((popup) => popup.code && popup.code === kept && popup.kind !== "message");
    if (held) showOfferNote(held);
    const popup = popups.find((item) => item && item.id && !popupSeen(item));
    if (!popup) return;
    const delay = Math.min(30, Math.max(0, Number(popup.delay) || 0)) * 1000;
    popupTimer = window.setTimeout(() => openNotice(popup), delay);
  }

  fetch("/api/content", { cache: "no-store" })
    .then((response) => (response.ok ? response.json() : null))
    .then((content) => {
      if (content) apply(content);
    })
    .catch(() => {
      /* на сайте остаются цены из сборки */
    });
</script>
