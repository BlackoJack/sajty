---
import { config, from, asset } from "../config";
import ContactIcon from "./ContactIcon.astro";

const demos = {
  visitka: asset("demo/manicure.html"),
  catalog: asset("demo/auto.html"),
  landing: asset("demo/coffee.html"),
};
---

<section id="top" class="border-b border-[color-mix(in_srgb,var(--color-ink)_13%,transparent)]">
  <div class="mx-auto w-full max-w-[1240px] px-6 pb-16 pt-14 md:px-10 md:pb-24 md:pt-16">
    <p class="mono flex items-center gap-3 text-muted">
      <span class="inline-block h-2 w-2 rounded-full bg-lime ring-4 ring-lime/25" aria-hidden="true"></span>
      Сайты для небольших дел · Новосибирск
    </p>

    <h1 class="mt-7 text-[clamp(34px,6vw,84px)] font-semibold leading-[0.96] tracking-[-0.04em]">
      Сайт вместо переписки
    </h1>

    <div class="mt-12 grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <p class="max-w-[54ch] text-[17px] leading-relaxed text-ink/80 md:text-[18px]">
          Цены, работы, запись и адрес — на одной странице. Вместо двадцати сообщений в личке одна ссылка.
          Визитка, каталог или лендинг за 2–3 дня, без конструктора и ежемесячной платы.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a data-contact="telegram" href={config.contacts.telegram.url} class="btn btn-lime" target="_blank" rel="noopener">
            <ContactIcon name="telegram" size={16} />
            Написать в Telegram
            <span aria-hidden="true">→</span>
          </a>
          <a href="#calc" class="btn btn-ghost">Сколько стоит</a>
        </div>

        <p data-contact-group class="mt-4 text-[13.5px] text-muted">
          или сразу в{" "}
          <a data-contact="whatsapp" href={config.contacts.whatsapp.url} class="inline-flex items-center gap-1 underline decoration-ink/25 underline-offset-4 transition-colors hover:text-ink" target="_blank" rel="noopener"><ContactIcon name="whatsapp" size={14} />WhatsApp</a>
          <span data-contact-and> и </span>
          <a data-contact="max" href={config.contacts.max.url} class="inline-flex items-center gap-1 underline decoration-ink/25 underline-offset-4 transition-colors hover:text-ink" target="_blank" rel="noopener"><ContactIcon name="max" size={14} />Max</a>
        </p>

        <p class="mono mt-7 text-muted">Первый разговор — 15 минут, бесплатно</p>

        <dl class="mt-10 grid max-w-[520px] grid-cols-3 gap-4 border-t border-[color-mix(in_srgb,var(--color-ink)_13%,transparent)] pt-5">
          <div>
            <dt class="mono text-muted">Визитка</dt>
            <dd class="mt-1 whitespace-nowrap font-display text-[15px] font-semibold sm:text-[19px]" data-price-slot="visitka">{from(config.price.visitka)}</dd>
          </div>
          <div>
            <dt class="mono text-muted">Срок</dt>
            <dd class="mt-1 font-display text-[19px] font-semibold">2–3 дня</dd>
          </div>
          <div>
            <dt class="mono text-muted">Абонплата</dt>
            <dd class="mt-1 font-display text-[19px] font-semibold">нет</dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-5">
        <div class="frame">
          <div class="frame-bar">
            <span class="frame-dot"></span><span class="frame-dot"></span><span class="frame-dot"></span>
            <span class="frame-url" id="mock-url">мастерская.ру</span>
          </div>

          <div class="p-3">
            <div class="mock-switch" role="group" aria-label="Тип сайта">
              <button type="button" data-view-btn="visitka" aria-pressed="true">Визитка</button>
              <button type="button" data-view-btn="catalog" aria-pressed="false">Каталог</button>
              <button type="button" data-view-btn="landing" aria-pressed="false">Лендинг</button>
            </div>

            <a
              id="mock-link"
              href={demos.visitka}
              target="_blank"
              rel="noopener"
              class="group mt-3 block aspect-[16/10] overflow-hidden bg-paper"
              aria-label="Открыть демо-сайт целиком"
            >
              <img
                data-view="visitka"
                src={asset("demo-manicure.png")}
                alt="Демо-сайт студии маникюра: крупный заголовок, фотографии работ и цены"
                class="block h-full w-full object-cover object-top"
              />
              <img
                data-view="catalog"
                src={asset("demo-auto.png")}
                alt="Демо-сайт автосервиса: тёмная страница с услугами и ценами"
                class="block h-full w-full object-cover object-top"
                hidden
              />
              <img
                data-view="landing"
                src={asset("demo-landing.png")}
                alt="Демо-лендинг кофейни на выезд: заголовок, цена и три преимущества"
                class="block h-full w-full object-cover object-top"
                hidden
              />
            </a>
          </div>
        </div>

        <p class="mono mt-4 text-muted">
          Переключите тип · это настоящие страницы, клик откроет целиком
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-view-btn]"));
  const views = Array.from(document.querySelectorAll<HTMLElement>("[data-view]"));
  const link = document.getElementById("mock-link") as HTMLAnchorElement | null;
  const url = document.getElementById("mock-url");

  const meta: Record<string, { href: string; url: string }> = {
    visitka: { href: "", url: "мастерская.ру" },
    catalog: { href: "", url: "гараж54.ру" },
    landing: { href: "", url: "тёплый.ру" },
  };

  // адреса демо-страниц берём из текущей ссылки, подставляя нужный файл
  if (link) {
    const base = link.href.replace(/demo\/[^/]+\.html$/, "demo/");
    meta.visitka.href = base + "manicure.html";
    meta.catalog.href = base + "auto.html";
    meta.landing.href = base + "coffee.html";
  }

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const key = button.dataset.viewBtn ?? "visitka";
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.viewBtn === key)));
      views.forEach((v) => {
        v.hidden = v.dataset.view !== key;
      });
      if (link) link.href = meta[key]?.href ?? link.href;
      if (url) url.textContent = meta[key]?.url ?? "";
    });
  });
</script>
