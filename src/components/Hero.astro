---
import { config, from } from "../config";
---

<section id="top" class="border-b border-[color-mix(in_srgb,var(--color-ink)_13%,transparent)]">
  <div class="mx-auto w-full max-w-[1240px] px-6 pb-16 pt-14 md:px-10 md:pb-24 md:pt-16">
    <p class="mono flex items-center gap-3 text-muted">
      <span class="inline-block h-2 w-2 rounded-full bg-lime ring-4 ring-lime/25" aria-hidden="true"></span>
      Сайты для небольших дел · Новосибирск
    </p>

    <h1 class="mt-7 text-[clamp(34px,6vw,84px)] font-semibold leading-[0.96] tracking-[-0.04em]">
      Сайт, который<span class="hidden md:inline"><br /></span> не стыдно отправить
    </h1>

    <div class="mt-12 grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <p class="max-w-[52ch] text-[17px] leading-relaxed text-ink/80 md:text-[18px]">
          Визитка, каталог или лендинг для небольшого дела: мастерской, салона, автосервиса, репетитора.
          Без конструкторов и ежемесячной платы — сайт остаётся вашим.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={config.contacts.telegram.url} class="btn btn-lime" target="_blank" rel="noopener">
            Написать в Telegram
            <span aria-hidden="true">→</span>
          </a>
          <a href="#calc" class="btn btn-ghost">Сколько стоит</a>
        </div>

        <p class="mono mt-7 text-muted">Первый разговор — 15 минут, бесплатно</p>

        <dl class="mt-10 grid max-w-[520px] grid-cols-3 gap-4 border-t border-[color-mix(in_srgb,var(--color-ink)_13%,transparent)] pt-5">
          <div>
            <dt class="mono text-muted">Визитка</dt>
            <dd class="mt-1 whitespace-nowrap font-display text-[15px] font-semibold sm:text-[19px]">{from(config.price.visitka)}</dd>
          </div>
          <div>
            <dt class="mono text-muted">Срок</dt>
            <dd class="mt-1 whitespace-nowrap font-display text-[15px] font-semibold sm:text-[19px]">2–3 дня</dd>
          </div>
          <div>
            <dt class="mono text-muted">Абонплата</dt>
            <dd class="mt-1 whitespace-nowrap font-display text-[15px] font-semibold sm:text-[19px]">нет</dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-5">
        <div class="frame">
          <div class="frame-bar">
            <span class="frame-dot"></span><span class="frame-dot"></span><span class="frame-dot"></span>
            <span class="frame-url">ваше-дело.ру</span>
          </div>

          <div class="page-mock">
            <div class="mock-switch" role="group" aria-label="Тип сайта">
              <button type="button" data-view-btn="visitka" aria-pressed="true">Визитка</button>
              <button type="button" data-view-btn="catalog" aria-pressed="false">Каталог</button>
              <button type="button" data-view-btn="landing" aria-pressed="false">Лендинг</button>
            </div>

            <div class="mt-4" data-view="visitka">
              <div class="mock-h w-[78%]"></div>
              <div class="mock-line mt-3"></div>
              <div class="mock-line short mt-2"></div>
              <div class="mt-3 h-8 w-28 bg-lime"></div>
              <div class="mock-grid mt-4">
                <div class="mock-tile"></div>
                <div class="mock-tile"></div>
                <div class="mock-tile"></div>
              </div>
            </div>

            <div class="mt-4" data-view="catalog" hidden>
              <div class="mock-line short"></div>
              <div class="mock-grid mt-3">
                <div class="mock-tile tall"></div>
                <div class="mock-tile tall"></div>
                <div class="mock-tile tall"></div>
                <div class="mock-tile tall"></div>
                <div class="mock-tile tall"></div>
                <div class="mock-tile tall"></div>
              </div>
              <div class="mt-3 flex gap-2">
                <div class="mock-line w-1/3"></div>
                <div class="mock-line w-1/4"></div>
              </div>
            </div>

            <div class="mt-4" data-view="landing" hidden>
              <div class="mock-h w-full"></div>
              <div class="mock-line mt-3"></div>
              <div class="mock-line mt-2"></div>
              <div class="mock-line short mt-2"></div>
              <div class="mt-3 h-10 w-full bg-lime"></div>
              <div class="mock-grid mt-3">
                <div class="mock-tile"></div>
                <div class="mock-tile"></div>
                <div class="mock-tile"></div>
              </div>
            </div>
          </div>
        </div>

        <p class="mono mt-4 text-muted">Переключите тип — покажу, как это выглядит</p>
      </div>
    </div>
  </div>
</section>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-view-btn]"));
  const views = Array.from(document.querySelectorAll<HTMLElement>("[data-view]"));

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const key = button.dataset.viewBtn;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.viewBtn === key)));
      views.forEach((v) => {
        v.hidden = v.dataset.view !== key;
      });
    });
  });
</script>
