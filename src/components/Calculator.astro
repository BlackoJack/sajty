---
import { money } from "../config";
import { packages } from "../data/packages";
import defaults from "../../yandex/lead/content.default.json";

const extras = [
  { id: "texts", label: "Помочь с текстами", price: defaults.price.texts, monthly: false },
  { id: "setup", label: "Домен, почта, аналитика", price: defaults.price.setup, monthly: false },
  { id: "support", label: "Поддержка после запуска", price: defaults.price.support, monthly: true },
];
---

<section id="calc" class="border-b border-[color-mix(in_srgb,var(--color-ink)_13%,transparent)]">
  <div class="mx-auto w-full max-w-[1240px] px-6 py-16 md:px-10 md:py-24">
    <div class="max-w-[58ch]">
      <p class="mono text-muted">03 — стоимость</p>
      <h2 class="mt-4 text-[clamp(28px,4.2vw,46px)] font-semibold leading-[1.05] tracking-[-0.03em]">
        Соберите свой вариант
      </h2>
      <p class="mt-4 text-[15.5px] leading-relaxed text-ink/75">
        Никаких «цена по запросу». Выберите, что нужно, — увидите вилку сразу. Это ориентир,
        точную сумму назову после короткого разговора.
      </p>
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <fieldset>
          <legend class="mono text-muted">Тип сайта</legend>
          <div class="mt-4 grid gap-2 sm:grid-cols-3" role="group" aria-label="Тип сайта">
            {
              packages.map((pkg) => (
                <button
                  type="button"
                  class="opt flex-col !items-start !gap-1"
                  data-type
                  data-id={pkg.id}
                  data-label={pkg.name}
                  data-price={pkg.price}
                  aria-pressed={pkg.id === "visitka" ? "true" : "false"}
                >
                  <span class="text-[15px] font-medium">{pkg.name}</span>
                  <span class="font-mono text-[11px] text-ink/55">от {money(pkg.price)} ₽</span>
                </button>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="mt-8">
          <legend class="mono text-muted">Дополнительно</legend>
          <div class="mt-4 space-y-2">
            {
              extras.map((extra) => (
                <button
                  type="button"
                  class="opt"
                  data-extra
                  data-id={extra.id}
                  data-label={extra.label}
                  data-price={extra.price}
                  data-monthly={extra.monthly ? "1" : "0"}
                  aria-pressed="false"
                >
                  <span class="tick" aria-hidden="true" />
                  <span>{extra.label}</span>
                  <span class="ml-auto font-mono text-[11px] text-ink/55">
                    + {money(extra.price)} ₽{extra.monthly ? "/мес" : ""}
                  </span>
                </button>
              ))
            }
          </div>
        </fieldset>

        <p class="mt-6 max-w-[52ch] text-[13.5px] leading-relaxed text-ink/55">
          Хостинг и домен — это отдельные платежи регистратору и провайдеру, примерно 2 000–4 000 ₽ в год.
          Они оформляются на вас, я их не забираю себе.
        </p>
      </div>

      <div class="lg:col-span-5">
        <div class="border border-[color-mix(in_srgb,var(--color-ink)_13%,transparent)] bg-paper p-6 md:p-7 lg:sticky lg:top-24">
          <p class="mono text-muted">Примерно</p>
          <p id="calc-total" class="mt-3 font-display text-[clamp(30px,4vw,42px)] font-semibold tracking-[-0.03em]">
            {money(defaults.price.visitka)} ₽
          </p>
          <p id="calc-month" class="mono mt-2 hidden text-muted"></p>

          <ul id="calc-list" class="mt-5 space-y-1.5 border-t border-[color-mix(in_srgb,var(--color-ink)_13%,transparent)] pt-4 text-[13.5px] text-ink/70" />

          <p class="mt-5 text-[12.5px] leading-relaxed text-ink/55">
            Часто выходит меньше: тексты, фото или почту иногда уже есть. Что не нужно — не считаю.
          </p>

          <a href="#contact" id="calc-cta" class="btn btn-lime mt-5 w-full">
            Обсудить этот вариант
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const typeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-type]"));
  const extraButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-extra]"));
  const totalEl = document.getElementById("calc-total");
  const monthEl = document.getElementById("calc-month");
  const listEl = document.getElementById("calc-list");
  const cta = document.getElementById("calc-cta") as HTMLAnchorElement | null;
  const task = document.getElementById("task") as HTMLTextAreaElement | null;

  const fmt = (n: number) => n.toLocaleString("ru-RU").replace(/\u00A0/g, " ");

  function currentType() {
    return typeButtons.find((b) => b.getAttribute("aria-pressed") === "true") ?? typeButtons[0];
  }

  function selectedExtras() {
    return extraButtons.filter((b) => b.getAttribute("aria-pressed") === "true");
  }

  function render() {
    if (!totalEl || !listEl) return;

    const base = Number(currentType()?.dataset.price ?? 0);
    const extras = selectedExtras();

    let total = base;
    let monthly = 0;

    extras.forEach((b) => {
      const price = Number(b.dataset.price ?? 0);
      if (b.dataset.monthly === "1") monthly += price;
      else total += price;
    });

    totalEl.textContent = `${fmt(total)} ₽`;

    if (monthEl) {
      monthEl.textContent = monthly ? `+ ${fmt(monthly)} ₽ в месяц` : "";
      monthEl.classList.toggle("hidden", monthly === 0);
    }

    const items = [currentType()?.dataset.label ?? "", ...extras.map((b) => b.dataset.label ?? "")].filter(Boolean);
    listEl.innerHTML = items.map((label) => `<li>· ${label}</li>`).join("");

    if (cta) {
      cta.dataset.message = `Здравствуйте! Хочу сайт.\n\nТип: ${currentType()?.dataset.label}\n${
        extras.length ? "Дополнительно: " + extras.map((b) => b.dataset.label).join(", ") + "\n" : ""
      }По калькулятору выходит примерно ${fmt(total)} ₽.`;
    }
  }

  typeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      typeButtons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
      render();
    });
  });

  extraButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const pressed = button.getAttribute("aria-pressed") === "true";
      button.setAttribute("aria-pressed", String(!pressed));
      render();
    });
  });

  cta?.addEventListener("click", () => {
    if (task && cta.dataset.message) task.value = cta.dataset.message;
  });

  document.addEventListener("site-content", render);
  render();
  if (document.documentElement.dataset.contentReady === "1") render();
</script>
