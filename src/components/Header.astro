---
import { config } from "../config";
---

<header class="sticky top-0 z-40 border-b border-[color-mix(in_srgb,var(--color-ink)_13%,transparent)] bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 w-full max-w-[1240px] items-center justify-between px-6 md:px-10">
    <a href="#top" class="group flex items-center gap-3" aria-label={config.role}>
      <span
        class="grid h-9 w-9 place-items-center bg-lime font-mono text-[12px] font-bold tracking-[0.04em] text-ink transition-transform duration-200 group-hover:-rotate-3"
        aria-hidden="true">{config.initials}</span
      >
      <span class="hidden text-[15px] font-medium sm:block">Сайты для небольших дел</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Разделы">
      <a href="#packages" class="text-[14px] text-ink/80 transition-colors hover:text-ink">Что делаю</a>
      <a href="#calc" class="text-[14px] text-ink/80 transition-colors hover:text-ink">Стоимость</a>
      <a href="#faq" class="text-[14px] text-ink/80 transition-colors hover:text-ink">Вопросы</a>
    </nav>

    <a href="#contact" class="btn btn-lime !py-2.5 !text-[11px]">Написать</a>
  </div>
</header>
