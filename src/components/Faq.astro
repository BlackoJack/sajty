---
import { faq } from "../data/content";
---

<section id="faq" class="border-b border-[color-mix(in_srgb,var(--color-ink)_13%,transparent)]">
  <div class="mx-auto w-full max-w-[1240px] px-6 py-16 md:px-10 md:py-24">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <p class="mono text-muted">06 — вопросы</p>
        <h2 class="mt-4 text-[clamp(28px,4.2vw,46px)] font-semibold leading-[1.05] tracking-[-0.03em]">
          Отвечаю заранее
        </h2>
        <p class="mt-4 max-w-[34ch] text-[15px] leading-relaxed text-ink/70">
          Если вашего вопроса тут нет — напишите. Отвечу честно, даже если ответ «вам это не нужно».
        </p>
      </div>

      <div class="lg:col-span-8">
        {
          faq.map((item) => (
            <details class="faq-item" name="faq">
              <summary>{item.q}</summary>
              <div class="answer">{item.a}</div>
            </details>
          ))
        }
        <div class="border-t border-[color-mix(in_srgb,var(--color-ink)_13%,transparent)]" />
      </div>
    </div>
  </div>
</section>
